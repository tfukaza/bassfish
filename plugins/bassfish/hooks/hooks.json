{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "bassfish",
            "tool": "deliverHostNotifications",
            "input": {
              "sessionId": "${session_id}",
              "workspace": "${cwd}",
              "phase": "prompt",
              "turnId": "${turn_id}"
            },
            "timeout": 15,
            "statusMessage": "Restoring Bassfish session identity"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "bassfish",
            "tool": "deliverHostNotifications",
            "input": {
              "sessionId": "${session_id}",
              "workspace": "${cwd}",
              "phase": "active",
              "turnId": "${turn_id}"
            },
            "timeout": 15,
            "statusMessage": "Checking Bassfish notifications"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "bassfish",
            "tool": "deliverHostNotifications",
            "input": {
              "sessionId": "${session_id}",
              "workspace": "${cwd}",
              "phase": "idle",
              "turnId": "${turn_id}"
            },
            "timeout": 15,
            "statusMessage": "Bassfish idle listener ready"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "bassfish",
            "tool": "deliverHostNotifications",
            "input": {
              "sessionId": "${session_id}",
              "workspace": "${cwd}",
              "turnId": "${turn_id}",
              "phase": "paused"
            },
            "timeout": 3
          }
        ]
      }
    ]
  }
}
