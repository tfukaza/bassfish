 /// `DATABASE_MANAGER` registry.
 type StatementHandle = Arc<RefCell<Option<turso_core::Statement>>>;
 
+
+/// Prune on a separate prepare counter, never on registry length (live handles
+/// can keep length above the threshold). Keep live handles for close().
+#[derive(Default)]
+struct StatementRegistry {
+    handles: Vec<Weak<RefCell<Option<turso_core::Statement>>>>,
+    prepares_since_prune: u32,
+    prepare_count: u64,
+    prune_count: u64,
+}
+
+impl StatementRegistry {
+    fn register(&mut self, stmt: &StatementHandle) {
+        self.prepare_count += 1;
+        self.prepares_since_prune += 1;
+        if self.prepares_since_prune == 256 {
+            self.handles.retain(|handle| handle.strong_count() > 0);
+            self.prepares_since_prune = 0;
+            self.prune_count += 1;
+        }
+        self.handles.push(Arc::downgrade(stmt));
+    }
+}
+
+#[napi(object)]
+pub struct StatementRegistryStats {
+    pub prepare_count: f64,
+    pub retained_references: u32,
+    pub live_references: u32,
+    pub prune_count: f64,
+}
+
+#[napi]
+pub fn bassfish_binding_identity() -> String {
+    "0.7.2-bassfish.1".to_owned()
+}
+
