 #[cfg(test)]
 mod tests {
+    #[test]
+    fn registry_prunes_dead_handles_on_prepare_cadence_and_preserves_live_handles() {
+        use super::*;
+        let mut registry = StatementRegistry::default();
+        let live = Arc::new(RefCell::new(None));
+        registry.register(&live);
+        for _ in 0..254 {
+            registry.register(&Arc::new(RefCell::new(None)));
+        }
+        assert_eq!(registry.handles.len(), 255);
+        registry.register(&Arc::new(RefCell::new(None)));
+        assert_eq!(registry.handles.len(), 2);
+        assert!(registry.handles[0].upgrade().is_some());
+        // More than 256 live handles must not cause pruning on every prepare.
+        let handles: Vec<_> = (0..300).map(|_| Arc::new(RefCell::new(None))).collect();
+        for handle in &handles { registry.register(handle); }
+        assert_eq!(registry.prune_count, 2);
+        assert_eq!(registry.prepare_count, 556);
+        assert_eq!(registry.handles.iter().filter(|s| s.upgrade().is_some()).count(), 301);
+    }
